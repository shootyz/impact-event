# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # Never expose this client-side

# App
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Admin authentication (single shared secret — use a long random string)
ADMIN_PASSWORD=change-me-use-a-long-random-string

# Cron authentication (Vercel injects this automatically for cron jobs)
CRON_SECRET=change-me-use-a-long-random-string

# Demo seeding — leave UNSET in production. Set to "true" only in a dev/staging
# environment to enable POST /api/admin/seed-demo (wipes + recreates demo data).
ALLOW_DEMO_SEED=

# Email (Resend) — used only for per-registration ticket confirmations
# (lib/email.ts), which are naturally low-volume and don't hit rate limits.
RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL=events@yourdomain.ch
ADMIN_NOTIFICATION_EMAIL=info@impactgstaad.ch

# Email (Brevo) — used for campaign/mailing sends (lib/campaign-email.ts),
# which can spike well past Resend's free-tier daily cap. BREVO_WEBHOOK_SECRET
# is a bearer token you choose yourself and register on the Brevo webhook (see
# app/api/webhooks/brevo/route.ts) — Brevo doesn't sign payloads with an HMAC
# like Resend does, so this bearer check is the only authenticity check.
BREVO_API_KEY=xkeysib-your_key
BREVO_FROM_EMAIL=events@yourdomain.ch
BREVO_WEBHOOK_SECRET=change-me-use-a-long-random-string

# Apple Wallet (optional) — signerCert and signerKey must be separate PEM
# values (see scripts/p12-to-pem.js), not the raw .p12 file used for both.
APPLE_PASS_TYPE_IDENTIFIER=
APPLE_TEAM_IDENTIFIER=
APPLE_PASS_CERT_B64=
APPLE_PASS_KEY_B64=
APPLE_PASS_CERT_PASSWORD=
APPLE_WWDR_CERT_B64=

# Google Wallet (optional) — GOOGLE_WALLET_SERVICE_ACCOUNT_B64 is the entire
# downloaded service-account JSON key file, base64-encoded as one line
# (base64 -i service-account.json | tr -d '\n').
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_B64=
